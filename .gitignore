# Python env and caches
.venv/
__pycache__/
*.pyc

# Upstream repos: clone them yourself (see README Part A)
microduck/
microduck_rl/
mujoco-simulink-blockset/

# Downloaded pretrained policies (fetch from Hugging Face, see policies/manifest.json)
policies/*.onnx

# Copied upstream model files and meshes (regenerated by scripts/make_duck_v4.py)
model/*
!model/duck_v4*.xml
!model/stand_numbers.json

# Copies made by ros2/setup_ws.sh and setup_nav.sh
ros2/*/meshes/
ros2/*/mjcf/
ros2/*/models/
ros2/*/build/
ros2/*/install/
ros2/*/log/

# YOLO training artifacts (regenerate with scripts/yolo_*.py)
yolo/dataset/
yolo/runs/
yolo/*.pt
yolo/*.onnx
yolo/train.log

# MATLAB build output
*.mexw64
*.asv
slprj/
*.slxc


# S8/S9: versioned design + generated records
design/original_parts/
!model/mass_ledger*.json
!model/checksums.json

# The trained detector is shipped (it is ours, not upstream); regenerate with scripts/yolo_*.py
!yolo/duck_yolo.onnx

# Training runs (checkpoints are large; the released policy is copied to policies/)
training/runs/
