Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: SLAM map
      Enabled: true
      Topic:
        Value: /map
      Alpha: 0.8
    - Class: rviz_default_plugins/MarkerArray
      Name: True world (walls, boxes, beacon)
      Enabled: true
      Topic:
        Value: /world/markers
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/RobotModel
      Name: Duck (at the SLAM estimate)
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Topic:
        Value: /plan
      Color: 255; 160; 0
      Line Style: Billboards
      Line Width: 0.02
    - Class: rviz_default_plugins/Pose
      Name: Ground truth pose
      Enabled: true
      Topic:
        Value: /ground_truth/pose
      Color: 0; 170; 0
      Shaft Length: 0.15
      Head Length: 0.06
      Shaft Radius: 0.01
      Head Radius: 0.03
    - Class: rviz_default_plugins/PointStamped
      Name: Beacon estimate
      Enabled: true
      Topic:
        Value: /goal
      Color: 255; 0; 255
      Radius: 0.06
    - Class: rviz_default_plugins/Image
      Name: YOLO camera
      Enabled: true
      Topic:
        Value: /yolo/image
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7.5
      Focal Point:
        X: 1.9
        Y: 0
        Z: 0
      Pitch: 1.1
      Yaw: 4.71
      Target Frame: map
Window Geometry:
  Height: 900
  Width: 1500
