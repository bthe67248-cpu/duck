<?xml version="1.0"?>
<package format="3">
  <name>duck_nav</name>
  <version>0.1.0</version>
  <description>Duckling V3 in a MuJoCo room: camera + depth SLAM, YOLO detection, exploration and navigation</description>
  <maintainer email="user@example.com">duckling</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>duck_description</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- world_sim also needs pip packages mujoco and onnxruntime (see ros2/setup_nav.sh); usb_camera_node needs
       python3-opencv on the robot only. -->
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
